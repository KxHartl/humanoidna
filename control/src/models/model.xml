<mujoco model="3dof_arm">

  <option timestep="0.01" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1"/>
    <geom type="capsule" size="0.03 0.3" mass="1"/>
  </default>

  <worldbody>

    <!-- LINK 1 -->
    <body name="link1" pos="0 0 0">
      <joint name="joint1" type="hinge" axis="0 0 1"/>
      <geom fromto="0 0 0 0 0 0.6"/>

      <!-- LINK 2 -->
      <body name="link2" pos="0 0 0.6">
        <joint name="joint2" type="hinge" axis="0 1 0"/>
        <geom fromto="0 0 0 0 0 0.6"/>

        <!-- LINK 3 -->
        <body name="link3" pos="0 0 0.6">
          <joint name="joint3" type="hinge" axis="1 0 0"/>
          <geom fromto="0 0 0 0 0 0.6"/>
        </body>

      </body>
    </body>

  </worldbody>


  <actuator>
    <motor joint="joint1" ctrlrange="-200 200"/>
    <motor joint="joint2" ctrlrange="-200 200"/>
    <motor joint="joint3" ctrlrange="-200 200"/>
  </actuator>

</mujoco>




